{
  "lint": {
    "commands": {
      "javascript": {
        "tool": "eslint",
        "command": ["./node_modules/.bin/eslint", "--no-fix", "--max-warnings", "0"],
        "appendPaths": true
      },
      "python": {
        "tool": "ruff",
        "command": ["npm", "run", "lint:python"]
      }
    }
  }
}
