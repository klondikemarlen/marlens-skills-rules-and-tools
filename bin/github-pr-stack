#!/usr/bin/env node
import { spawnSync } from "node:child_process"
import process from "node:process"

const usage = `Usage:
  github-pr-stack [--link] [--json] <pull-request-url> [<pull-request-url> ...]

Preflight a GitHub pull-request stack supplied bottom to top.

Confirms every PR belongs to the same repository, reports its base/head
branches, exact SHAs, draft state, and current native stack membership,
then prints the \`gh stack link\` registration command without running it.

Options:
  --link   Run \`gh stack link\` with the given PR URLs after preflight.
  --json   Print only the JSON report (errors exit non-zero either way).
  --help   Show this help.
`

const pullRequestUrlPattern = /^https:\/\/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)\/?$/

function parsePullRequestUrl(url) {
  const match = pullRequestUrlPattern.exec(url)
  if (!match) return null

  const [, owner, repo, number] = match
  return { owner, repo, number: Number(number), url }
}

function ghApi(path) {
  const result = spawnSync(
    "gh",
    [
      "api",
      path,
      "--jq",
      "{number,state,draft,url:.html_url,repo:.base.repo.full_name,base:.base.ref,base_sha:.base.sha,head:.head.ref,head_sha:.head.sha,stack}",
    ],
    { encoding: "utf8" }
  )

  if (result.error) throw result.error
  if (result.status !== 0) {
    const output = `${result.stderr}${result.stdout}`.trim()
    throw new Error(output || `gh api ${path} failed.`)
  }

  return JSON.parse(result.stdout)
}

function main(argv) {
  const runLink = argv.includes("--link")
  const jsonOnly = argv.includes("--json")
  const urls = argv.filter((argument) => argument !== "--link" && argument !== "--json")

  if (argv.includes("--help") || argv.includes("-h") || urls.length < 2) {
    console.log(usage)
    return urls.length < 2 && !argv.includes("--help") && !argv.includes("-h") ? 2 : 0
  }

  const errors = []
  const members = []

  for (const [position, url] of urls.entries()) {
    const parsed = parsePullRequestUrl(url)
    if (!parsed) {
      errors.push(`unrecognized pull request URL: ${url}`)
      continue
    }

    let pull
    try {
      pull = ghApi(`repos/${parsed.owner}/${parsed.repo}/pulls/${parsed.number}`)
    } catch (error) {
      errors.push(`failed to read ${url}: ${error.message}`)
      continue
    }

    if (pull.repo !== `${parsed.owner}/${parsed.repo}`) {
      errors.push(`${url} resolves to a different repository (${pull.repo})`)
    }

    members.push({
      position: position + 1,
      url: pull.url,
      repo: pull.repo,
      state: pull.state,
      draft: pull.draft,
      base: pull.base,
      base_sha: pull.base_sha,
      head: pull.head,
      head_sha: pull.head_sha,
      stack: pull.stack ?? null,
    })
  }

  const repos = new Set(members.map((member) => member.repo))
  if (repos.size > 1) {
    errors.push(`pull requests span multiple repositories: ${[...repos].join(", ")}`)
  }

  for (const member of members) {
    if (member.state !== "open") {
      errors.push(`${member.url} is ${member.state}, not open`)
    }
  }

  for (let index = 1; index < members.length; index += 1) {
    const previous = members[index - 1]
    const member = members[index]
    if (member.base !== previous.head) {
      errors.push(
        `${member.url} bases on ${member.base}; expected the predecessor head ${previous.head}`
      )
    }
  }

  const linkCommand = `gh stack link ${urls.map((url) => `\\\n  ${url}`).join(" ")}`
  const report = { members, errors, linkCommand }

  if (jsonOnly) {
    console.log(JSON.stringify(report, null, 2))
  } else {
    console.log(JSON.stringify(report, null, 2))
    if (errors.length === 0) {
      console.log("\nRegistration command (not executed):")
      console.log(`  ${linkCommand}`)
    }
  }

  if (runLink) {
    if (errors.length > 0) {
      console.error("Refusing --link while preflight errors exist.")
      return 1
    }

    const link = spawnSync("gh", ["stack", "link", ...urls], {
      encoding: "utf8",
      stdio: "inherit",
    })

    if (link.error) throw link.error
    if (link.status !== 0) return link.status
  }

  return errors.length > 0 ? 1 : 0
}

try {
  process.exitCode = main(process.argv.slice(2))
} catch (error) {
  console.error(`github-pr-stack: ${error.message}`)
  process.exitCode = 1
}
