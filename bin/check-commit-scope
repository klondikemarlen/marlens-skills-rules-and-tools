#!/usr/bin/env node

import { execFileSync } from "node:child_process"
import { existsSync, readFileSync } from "node:fs"
import path from "node:path"
import { checkCommitScope, formatCommitScopeFailures } from "../lib/commit-scope-check.mjs"
import { runVerification as verifyNoEnvrcExample } from "../verifications/no-envrc-example.mjs"
import { runStagedVerification as verifyStagedSourceFiles } from "../verifications/no-oversized-source-files.mjs"

function stagedPaths() {
  return execFileSync("git", ["diff", "--cached", "--name-only", "-z"], {
    encoding: "utf8",
  })
    .split("\0")
    .filter(Boolean)
}

function repositoryRoot() {
  return execFileSync("git", ["rev-parse", "--show-toplevel"], {
    encoding: "utf8",
  }).trim()
}

function atomicGroups() {
  const configPath = path.join(repositoryRoot(), ".commit-scope.json")

  if (!existsSync(configPath)) return []

  const { atomicGroups: configuredGroups = [] } = JSON.parse(readFileSync(configPath, "utf8"))
  if (!Array.isArray(configuredGroups)) throw new Error("atomicGroups must be an array.")

  for (const group of configuredGroups) {
    if (
      !Array.isArray(group) ||
      group.length < 2 ||
      !group.every((filePath) => typeof filePath === "string")
    ) {
      throw new Error("Each atomic group must list at least two file paths.")
    }
  }

  return configuredGroups
}

function normalizedPath(filePath) {
  return filePath.replaceAll("\\", "/").replace(/^\.\//, "")
}

function isComposePath(filePath) {
  return /(?:^|\/)(?:docker-)?compose(?:\.[^.]+)?\.ya?ml$/iu.test(normalizedPath(filePath))
}

function stagedFile(filePath) {
  return execFileSync("git", ["show", `:${filePath}`], { encoding: "utf8" })
}

function mappingValue(source, name) {
  const match = source.match(
    new RegExp(`(?:^\\s*|[,{]\\s*)${name}:\\s*(?:"([^"]+)"|'([^']+)'|([^,}\\s#]+))`, "u")
  )

  return match?.[1] ?? match?.[2] ?? match?.[3] ?? null
}

function buildSpecifications(composeSource) {
  const specifications = []
  let build = null

  function addBuild() {
    if (build?.dockerfile) specifications.push(build)
    build = null
  }

  for (const line of composeSource.split("\n")) {
    const inline = line.match(/^\s*build:\s*\{(.*)\}\s*$/u)
    if (inline) {
      const dockerfile = mappingValue(inline[1], "dockerfile")
      if (dockerfile)
        specifications.push({
          context: mappingValue(inline[1], "context") ?? ".",
          dockerfile,
        })
      continue
    }

    const nested = line.match(/^(\s*)build:\s*$/u)
    if (nested) {
      addBuild()
      build = { indent: nested[1].length, context: ".", dockerfile: null }
      continue
    }

    if (!build || line.trim() === "") continue
    const indent = line.match(/^\s*/u)[0].length
    if (indent <= build.indent) {
      addBuild()
      continue
    }

    build.context = mappingValue(line, "context") ?? build.context
    build.dockerfile = mappingValue(line, "dockerfile") ?? build.dockerfile
  }

  addBuild()
  return specifications
}

function composeDockerfilePairs(paths) {
  return paths.filter(isComposePath).flatMap((composePath) => {
    const normalizedComposePath = normalizedPath(composePath)
    const composeDirectory = path.posix.dirname(normalizedComposePath)

    return buildSpecifications(stagedFile(composePath))
      .filter(
        ({ context, dockerfile }) =>
          !path.posix.isAbsolute(context) && !path.posix.isAbsolute(dockerfile)
      )
      .map(({ context, dockerfile }) => ({
        composePath: normalizedComposePath,
        dockerfilePath: path.posix.normalize(
          path.posix.join(composeDirectory, context, dockerfile)
        ),
      }))
  })
}

const paths = stagedPaths()
const { boundaries } = checkCommitScope(paths, {
  atomicGroups: atomicGroups(),
  composeDockerfilePairs: composeDockerfilePairs(paths),
})

const hygieneFailures = [verifyNoEnvrcExample(), verifyStagedSourceFiles()].filter(
  ({ status }) => status !== "PASS"
)

if (boundaries.length === 0) {
  console.log("Staged files satisfy commit file-type boundaries.")
} else if (process.argv.includes("--allow-mixed")) {
  console.warn(`${formatCommitScopeFailures(boundaries)}\nOverride accepted.`)
} else {
  console.error(formatCommitScopeFailures(boundaries))
  process.exitCode = 1
}

for (const { summary, evidence } of hygieneFailures) {
  console.error(`${summary}\n${evidence}`)
  process.exitCode = 1
}
